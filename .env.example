# Copy to .env and replace every value. Generate secrets with: openssl rand -hex 32
AGGW_GRANT_SECRET=replace-with-64-hex-chars
AGGW_AUDIT_KEY=replace-with-64-hex-chars
AGGW_ADMIN_TOKEN=replace-with-a-long-random-token

# Optional: policy file inside the container (defaults to the bundled example)
# AGGW_POLICY=/app/policies/support-agent.yaml

# Optional: model endpoint for `aggw agent` (OpenAI, Azure OpenAI, vLLM, Ollama, LiteLLM)
# AGGW_LLM_BASE_URL=https://api.openai.com/v1
# AGGW_LLM_MODEL=gpt-4o-mini
# AGGW_LLM_API_KEY=
# AGGW_AZURE_API_VERSION=
